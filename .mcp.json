{
  "mcpServers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "dotnet-mcp": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "Community.Mcp.DotNet@1.*",
        "--yes"
      ],
      "env": {}
    },
    "nuget-mcp": {
      "type": "stdio",
      "command": "dnx",
      "args": [
        "NuGet.Mcp.Server",
        "--prerelease",
        "--yes"
      ],
      "env": {}
    }
  }
}